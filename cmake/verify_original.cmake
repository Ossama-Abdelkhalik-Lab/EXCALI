file(READ "${SOURCE_ROOT}/original/SHA256.json" manifest)
string(JSON count LENGTH "${manifest}")
math(EXPR last "${count} - 1")
foreach(i RANGE ${last})
    string(JSON path GET "${manifest}" ${i} path)
    string(JSON expected GET "${manifest}" ${i} sha256)
    file(SHA256 "${SOURCE_ROOT}/${path}" actual)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "Original source changed: ${path}")
    endif()
endforeach()
message(STATUS "Original Exact v2.2 files match their import hashes")
